
# ============================================================
# PneumoLens - Git Ignore Configuration
# Explainable & Uncertainty-Aware Pneumonia Classification
# ============================================================

# ------------------------------------------------------------
# 1. Python Cache & Compiled Files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# ------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ------------------------------------------------------------
# 3. Environment Variables & Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
kaggle.json
.streamlit/secrets.toml

# ------------------------------------------------------------
# 4. Jupyter Notebook & IPython
# ------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ------------------------------------------------------------
# 5. Medical Dataset - Keep Local Only
# ------------------------------------------------------------

# Original chest X-ray images
data/raw/*
!data/raw/.gitkeep

# Processed images and split files
data/processed/*
!data/processed/.gitkeep

# Detailed dataset manifests
data/manifests/*
!data/manifests/.gitkeep

# Detailed dataset audit outputs
data/audit/*
!data/audit/.gitkeep

# ------------------------------------------------------------
# 6. PyTorch & Deep Learning Model Weights
# ------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.keras
*.safetensors

# Generated model artifacts
artifacts/*
!artifacts/.gitkeep
!artifacts/README.md

# ------------------------------------------------------------
# 7. Experiment Tracking
# ------------------------------------------------------------
wandb/
mlruns/
lightning_logs/
runs/
logs/
tensorboard/
events.out.tfevents.*

# ------------------------------------------------------------
# 8. Temporary Files & Archives
# ------------------------------------------------------------
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*.zip
*.7z

# ------------------------------------------------------------
# 9. Testing & Coverage
# ------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------
# 10. IDE & Editor Files
# ------------------------------------------------------------
.vscode/
.idea/
.spyderproject
.spyproject
tempCodeRunnerFile.py

# ------------------------------------------------------------
# 11. Operating System Files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# 12. Python Packaging
# ------------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/

# ============================================================
# Files intentionally tracked on GitHub:
#
# README.md
# requirements.txt
# notebooks/*.ipynb
# reports/Phase 1/*.md
# reports/Phase 1/*.json
# reports/tables/*.csv
# reports/figures/*.png
# src/
# app/
# configs/
# docs/
# tests/
#
# NOTE: Keep detailed datasets and model weights local.
# ============================================================
